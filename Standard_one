class DataCache:
    """Manage local cache of downloaded datasets."""
    cache_dir = Path.home() / ".standard_one_cache"
    cache_dir.mkdir(exist_ok=True)

    @staticmethod
    def download(url: str, expected_hash: Optional[str] = None) -> Path:
        if not HAS_REQUESTS:
            raise ImportError("requests needed for downloading data")
        fname = url.split("/")[-1]
        path = DataCache.cache_dir / fname
        if path.exists():
            if expected_hash and hashlib.md5(path.read_bytes()).hexdigest() != expected_hash:
                path.unlink()
            else:
                return path
        logger.info(f"Downloading {url} …")
        r = requests.get(url, stream=True)
        r.raise_for_status()
        with open(path, 'wb') as f:
            for chunk in r.iter_content(chunk_size=8192):
                f.write(chunk)
        return path

class CERNDataLoader:
    """
    Load real LHC datasets from CERN Open Data.
    Examples: ATLAS Higgs ML dataset (CSV), CMS dimuon spectra (ROOT).
    """
    @staticmethod
    def load_atlas_higgs_ml() -> Tuple[torch.Tensor, torch.Tensor]:
        """Download and load the ATLAS Higgs boson machine learning challenge dataset.
        Returns features and labels (signal/background)."""
        url = "https://opendata.cern.ch/record/328/files/atlas-higgs-challenge-2014-v2.csv.gz"
        path = DataCache.download(url)
        import gzip, csv
        with gzip.open(path, 'rt') as f:
            reader = csv.reader(f)
            header = next(reader)
            data = np.array([list(map(float, row)) for row in reader])
        # First column is EventId, last is Label (s/b), others are features
        features = data[:, 1:-1]
        labels = data[:, -1]
        return torch.tensor(features, dtype=torch.float32), torch.tensor(labels, dtype=torch.long)

    @staticmethod
    def load_cms_dimuon(filepath: Union[str, Path], treename: str = "Events",
                        branches: List[str] = ["Muon_pt", "Muon_eta", "Muon_phi", "Muon_mass"]) -> torch.Tensor:
        """Load dimuon data from a CMS ROOT file (e.g., from CERN Open Data)."""
        if not HAS_UPROOT:
            raise ImportError("uproot required")
        with uproot.open(filepath) as f:
            tree = f[treename]
            arrays = tree.arrays(branches, library="np")
        # Convert to PyTorch
        data = {}
        for b in branches:
            data[b] = torch.tensor(ak.flatten(arrays[b]).to_numpy(), dtype=torch.float32)
        return data

