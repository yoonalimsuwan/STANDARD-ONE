class HardProcess:
    """Base class for partonic cross‑sections."""
    def __init__(self, forces: ForceParameters, pdf_set: Optional[PDFSet] = None,
                 device='cpu'):
        self.forces = forces
        self.pdf_set = pdf_set
        self.device = device

    def partonic_cross_section(self, x1, x2, Q, *args) -> torch.Tensor:
        """dσ̂ for given parton momenta fractions and scale Q."""
        raise NotImplementedError

    def hadronic_cross_section(self, sqrt_s: float, pdf_set: PDFSet = None) -> torch.Tensor:
        """Compute inclusive cross‑section using PDFs and VEGAS."""
        if pdf_set is None:
            pdf_set = self.pdf_set
        if pdf_set is None:
            raise ValueError("PDF set required for hadronic cross‑section")

        # integration variables: x1, x2 (subject to x1*x2*s = Q2)
        # We'll integrate over tau = x1*x2 and y = 0.5*ln(x1/x2)
        # For simplicity, just do double integral over x1,x2 with VEGAS
        s = sqrt_s**2
        n_events = 10000
        device = self.device

        # use VEGASIntegrator
        vegas = VEGASIntegrator(n_dim=2, n_events=n_events, device=device)

        def integrand(x):
            # x[:,0] -> x1, x[:,1] -> x2
            x1 = x[:,0]
            x2 = x[:,1]
            # kinematic limit: x1*x2 > m_min^2/s, but we set a threshold
            # ensure validity
            mask = (x1 > 1e-6) & (x2 > 1e-6) & (x1*x2 > (self.mass_threshold**2)/s)
            # Q scale
            Q = torch.sqrt(x1 * x2 * s)
            # PDF factors
            fx1 = pdf_set.gluon(x1, Q)  # adjust for initial partons
            fx2 = pdf_set.gluon(x2, Q)
            # partonic xs
            dsigma = self.partonic_cross_section(x1, x2, Q)
            # jacobian: dtau dy -> dx1 dx2 gives 1/(x1*x2) factor? We'll correct later.
            # For simplicity, we integrate over x1,x2 directly; Jacobian = 1.
            # flux factor 1/(2s)
            flux = 1.0 / (2.0 * s)
            weight = flux * dsigma * fx1 * fx2
            weight[~mask] = 0.0
            return weight

        # Run integration (this can be time‑consuming, but differentiable)
        integral, _ = vegas.integrate(integrand, n_batches=5)
        return integral

class DrellYan(HardProcess):
    """Neutral‑current Drell‑Yan pp -> Z/γ* -> l+l-."""
    def __init__(self, forces: ForceParameters, pdf_set: PDFSet = None, device='cpu'):
        super().__init__(forces, pdf_set, device)
        self.mass_threshold = 0.5  # GeV

    def partonic_cross_section(self, x1, x2, Q):
        # Simple LO formula: dσ̂ = (4πα^2/3Q^2) * sum_q e_q^2
        # With Z contribution would be more complex; for now just photon.
        alpha = self.forces.alpha_EM(Q)
        Q2 = Q**2
        # sum over light quarks (u,d,s,c,b) charges
        charge_sum = 2*( (2/3)**2 + (-1/3)**2 ) * 3  # colours
        dsigma = (4*math.pi*alpha**2) / (3*Q2) * charge_sum
        return dsigma * torch.ones_like(x1)  # constant in x at parton level

