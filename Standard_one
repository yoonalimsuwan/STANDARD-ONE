# 2. Fundamental Forces & Running Couplings (using parton)
# =============================================================================
class ForceParameters:
    """
    Store and evolve (differentiably) the coupling constants.
    Uses the parton library for PDFs and α_s(Q²) at NNLO.
    α_EM is taken as constant (1/137) with optional running.
    """
    def __init__(self, device='cpu'):
        self.device = device
        # α_s at M_Z from PDG 2022
        self.alpha_s_MZ = 0.1180
        self.MZ = 91.1876
        # setup parton α_s if available
        if HAS_PARTON:
            self._alpha_s_runner = qcd.AlphaS(alphas_ref=self.alpha_s_MZ,
                                              scale_ref=self.MZ,
                                              order=2)  # NNLO
        else:
            self._alpha_s_runner = None
        # α_EM (at zero momentum)
        self.alpha_EM_0 = 1.0 / 137.035999084
        # G_F
        self.G_F = 1.1663787e-5  # GeV^-2
        # G_N
        self.G_N = 6.70883e-39   # GeV^-2

    def alpha_s(self, Q: Union[float, torch.Tensor]) -> torch.Tensor:
        """α_s(Q²) with NNLO running. Q in GeV."""
        Q = torch.as_tensor(Q, dtype=torch.float32, device=self.device)
        if self._alpha_s_runner is not None:
            # parton expects Q in GeV, returns float; we need to vectorize
            if Q.dim() == 0:
                val = self._alpha_s_runner(Q.item())
                return torch.tensor(val, device=self.device)
            else:
                return torch.tensor([self._alpha_s_runner(q.item()) for q in Q],
                                    device=self.device)
        else:
            # One‑loop fallback
            b0 = (33 - 2*6) / (12*math.pi)  # Nf=6
            mu2 = self.MZ**2
            Q2 = Q**2
            denom = 1 + b0 * self.alpha_s_MZ * torch.log(Q2 / mu2)
            return self.alpha_s_MZ / denom

    def alpha_EM(self, Q: Union[float, torch.Tensor] = 0.0) -> torch.Tensor:
        """α_EM(Q²) with leading-order running from leptons."""
        Q = torch.as_tensor(Q, dtype=torch.float32, device=self.device)
        # one‑loop beta function for QED: beta0 = sum(Q_i^2)/(3π)
        # use only charged leptons: e, μ, τ
        beta0 = (1 + 1 + 1) / (3 * math.pi)  # for charges 1
        Q2 = Q**2 + 1e-12
        # low energy reference at me^2 (0.511 MeV)
        me2 = (0.511e-3)**2
        alpha_inv = 1.0/self.alpha_EM_0 - beta0 * torch.log(Q2 / me2)
        return 1.0 / alpha_inv

    def weak_coupling(self) -> torch.Tensor:
        return torch.tensor(self.G_F, device=self.device)

    def gravitational_coupling(self) -> torch.Tensor:
        return torch.tensor(self.G_N, device=self.device)


