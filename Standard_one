class PDFSet:
    """
    Differentiable PDF provider using the parton library (MIT).
    Supports MMHT2014, CT14, etc.
    """
    def __init__(self, pdf_name: str = "MMHT2014lo68cl", device='cpu'):
        if not HAS_PARTON:
            raise ImportError("parton library required for PDFs (pip install parton)")
        self.device = device
        self.pdf = pdf.PDF(pdf_name)
        self.pdf_name = pdf_name

    def xf(self, pid: int, x: torch.Tensor, Q: torch.Tensor) -> torch.Tensor:
        """Return x*f(x, Q) for parton with PDG id `pid`."""
        # parton expects float x, Q; we'll loop (inefficient but differentiable)
        # For batch, we can use a custom vectorized wrapper.
        out = []
        for xi, qi in zip(x.cpu().numpy(), Q.cpu().numpy()):
            val = self.pdf.xfxQ(pid, xi, qi)
            out.append(val)
        return torch.tensor(out, dtype=torch.float32, device=self.device, requires_grad=True)

    def gluon(self, x: torch.Tensor, Q: torch.Tensor) -> torch.Tensor:
        return self.xf(21, x, Q)

    def up(self, x: torch.Tensor, Q: torch.Tensor) -> torch.Tensor:
        return self.xf(2, x, Q)

    def down(self, x: torch.Tensor, Q: torch.Tensor) -> torch.Tensor:
        return self.xf(1, x, Q)

