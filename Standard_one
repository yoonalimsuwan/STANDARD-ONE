class HistFactoryModel(nn.Module):
    """
    Wrapper for pyhf HistFactory statistical model, fully differentiable
    via pyhf's torch backend.
    """
    def __init__(self, workspace_json: Union[str, Dict], device='cpu'):
        super().__init__()
        if not HAS_PYHF:
            raise ImportError("pyhf needed for HistFactory (pip install pyhf)")
        if isinstance(workspace_json, str):
            with open(workspace_json) as f:
                self.spec = json.load(f)
        else:
            self.spec = workspace_json
        self.model = pyhf.Model(self.spec, validate=False)
        self.device = device

    def forward(self, pars: torch.Tensor) -> torch.Tensor:
        """Return negative log‑likelihood for given parameter values."""
        # pyhf uses tensorflow or pytorch backend; set torch
        pyhf.set_backend("pytorch")
        # pars expected as concatenated [mu, nuisance]
        # We'll use the default model setup; this is a simplified interface.
        data = self.model.expected_data(pars)
        nll = -self.model.logpdf(pars, data)
        return nll

