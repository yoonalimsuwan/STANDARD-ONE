# =============================================================================
class Cosmology(nn.Module):
    """
    Differentiable FLRW cosmology with parameters: H0, Ω_m, Ω_Λ, w.
    Provides distances and simple CMB likelihood.
    """
    def __init__(self, H0=67.4, Omega_m=0.315, Omega_L=0.685, w=-1.0, device='cpu'):
        super().__init__()
        self.H0 = nn.Parameter(torch.tensor(H0, device=device))
        self.Omega_m = nn.Parameter(torch.tensor(Omega_m, device=device))
        self.Omega_L = nn.Parameter(torch.tensor(Omega_L, device=device))
        self.w = nn.Parameter(torch.tensor(w, device=device))
        self.device = device

    def _E(self, z: torch.Tensor) -> torch.Tensor:
        return torch.sqrt(self.Omega_m*(1+z)**3 + self.Omega_L*(1+z)**(3*(1+self.w)))

    def comoving_distance(self, z: Union[float, torch.Tensor]) -> torch.Tensor:
        z = torch.as_tensor(z, dtype=torch.float32, device=self.device)
        # integrate using trapezoidal rule over many points
        z_max = z.max().item()
        n_steps = 500
        grid = torch.linspace(0, z_max, n_steps, device=self.device)
        dz = grid[1] - grid[0]
        integrand = 1.0 / self._E(grid)
        # cumulative trapezoidal integral
        cumsum = torch.cumsum(integrand, dim=0) * dz
        # interpolate to required z
        indices = torch.searchsorted(grid, z)
        indices = torch.clamp(indices, 1, n_steps-1)
        dist = cumsum[indices-1] + (cumsum[indices] - cumsum[indices-1]) * (z - grid[indices-1]) / dz
        return (2997.92458 / self.H0) * dist  # c/H0 in Mpc

    def luminosity_distance(self, z: torch.Tensor) -> torch.Tensor:
        return self.comoving_distance(z) * (1+z)

    def angular_diameter_distance(self, z: torch.Tensor) -> torch.Tensor:
        return self.comoving_distance(z) / (1+z)

    def cmb_shift_parameter(self, z_star=1090.0) -> torch.Tensor:
        """Approximate CMB shift parameter R."""
        omega_m_h2 = self.Omega_m * (self.H0/100)**2
        # simple fit
        return torch.sqrt(omega_m_h2) * self.comoving_distance(z_star) / (2997.92458)

    def likelihood_planck(self, data: Tuple[torch.Tensor, torch.Tensor]) -> torch.Tensor:
        """Simple Gaussian likelihood for CMB power spectrum.
        Very simplified, not a real Planck likelihood."""
        ell_obs, D_obs = data
        # Use a toy model: D_theory = A * (ell/1000)^n_s-1
        A = 2.1e-9  # amplitude
        n_s = 0.965
        D_theory = A * (ell_obs/1000)**(n_s-1) * (ell_obs*(ell_obs+1))/(2*math.pi)
        chi2 = torch.sum((D_obs - D_theory)**2 / D_obs**2)  # rough
        return 0.5 * chi2

