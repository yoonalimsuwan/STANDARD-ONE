class StandardOne:
    """
    Top‑level unified framework for particle physics and cosmology research.
    Provides differentiable models, real data loaders, and statistical analysis tools.
    """
    def __init__(self, config: Dict = None, device='cpu'):
        self.device = get_device(device)
        self.config = config if config else {}
        self.forces = ForceParameters(device=self.device)
        self.pdf_set = None
        if self.config.get('use_pdf', True) and HAS_PARTON:
            pdf_name = self.config.get('pdf_name', 'MMHT2014lo68cl')
            self.pdf_set = PDFSet(pdf_name, device=self.device)
        self.matrix_elements = {
            'drell_yan': DrellYan(self.forces, self.pdf_set, self.device),
            'gg_H': HiggsGluonFusion(self.forces, self.pdf_set, self.device)
        }
        self.csoc = CSOCKernel(device=self.device)
        self.ssc = SemanticStateContraction()
        self.rg = DiffRGRefiner()
        self.cosmology = None
        self.hist_model = None

    def load_collider_data(self, dataset: str = 'atlas_higgs_ml') -> Any:
        if dataset == 'atlas_higgs_ml':
            return CERNDataLoader.load_atlas_higgs_ml()
        elif dataset == 'cms_dimuon':
            file = self.config.get('cms_file', '')
            return CERNDataLoader.load_cms_dimuon(file)
        else:
            raise ValueError(f"Unknown dataset: {dataset}")

    def load_cosmology_data(self, dataset: str = 'planck') -> Any:
        if dataset == 'planck':
            return NASADataLoader.load_planck_cmb_power_spectrum()
        elif dataset == 'jla':
            return NASADataLoader.load_supernovae_data()
        elif dataset == 'bao':
            return NASADataLoader.load_bao_data()
        else:
            raise ValueError(f"Unknown cosmology dataset: {dataset}")

    def setup_cosmology(self) -> Cosmology:
        cosmo = Cosmology(device=self.device)
        self.cosmology = cosmo
        return cosmo

    def setup_histfactory(self, workspace_json: Union[str, Dict]) -> HistFactoryModel:
        model = HistFactoryModel(workspace_json, device=self.device)
        self.hist_model = model
        return model

    def compute_hadronic_cross_section(self, process: str, sqrt_s: float) -> torch.Tensor:
        if process not in self.matrix_elements:
            raise ValueError(f"Unknown process {process}")
        return self.matrix_elements[process].hadronic_cross_section(sqrt_s, self.pdf_set)

    def fit_model(self, data: torch.Tensor, model: nn.Module, lr=0.01, epochs=100) -> List[float]:
        optimizer = torch.optim.Adam(model.parameters(), lr=lr)
        losses = []
        for _ in range(epochs):
            optimizer.zero_grad()
            loss = model(data)
            loss.backward()
            optimizer.step()
            losses.append(loss.item())
        return losses

    def run_unification_test(self, energy: float) -> Dict[str, float]:
        m = UnificationModel(device=self.device)
        Q = torch.tensor(energy, device=self.device)
        return {
            'alpha_s': m.running_su3(Q).item(),
            'alpha_2': m.running_su2(Q).item(),
            'alpha_1': m.running_u1(Q).item()
        }

