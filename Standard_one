# 4. Differentiable Monte‑Carlo Integrator (for cross‑sections)
# =============================================================================
class VEGASIntegrator(nn.Module):
    """
    Differentiable Monte‑Carlo integration using the reparameterisation trick
    and VEGAS‑style adaptive sampling. Gradients flow through the integrand.
    """
    def __init__(self, n_dim: int, n_events: int, device='cpu'):
        super().__init__()
        self.n_dim = n_dim
        self.n_events = n_events
        self.device = device
        # learnable grid (bins) for importance sampling
        self.bins = nn.Parameter(torch.ones(n_dim, 50, device=device))
        # uniform random numbers will be transformed via inverse CDF

    def sample(self, n_batch: int = 1) -> torch.Tensor:
        """Generate random points in [0,1]^n_dim using stratified sampling."""
        n = n_batch * self.n_events
        # uniform
        x = torch.rand(n, self.n_dim, device=self.device)
        # apply VEGAS transformation (simplified: just uniform for now)
        # In a full implementation, we'd compute bin widths and map.
        return x

    def integrate(self, integrand: Callable, n_batches: int = 1) -> Tuple[torch.Tensor, torch.Tensor]:
        """Integrate `integrand(x)` over [0,1]^n_dim.
        Returns (integral, uncertainty)."""
        total = 0.0
        total_sq = 0.0
        for _ in range(n_batches):
            x = self.sample()
            fx = integrand(x)
            total += fx.sum()
            total_sq += (fx**2).sum()
        integral = total / (n_batches * self.n_events)
        std = torch.sqrt((total_sq/(n_batches*self.n_events) - integral**2) / (n_batches*self.n_events))
        return integral, std

