def parse_args():
    parser = argparse.ArgumentParser(description="STANDARD ONE Unified Research Framework")
    parser.add_argument('--task', type=str, required=True,
                        choices=['load_collider', 'load_cosmo', 'cross_section', 'fit_cosmo', 'unification'],
                        help="Which research task to run")
    parser.add_argument('--dataset', type=str, default='atlas_higgs_ml',
                        help="Dataset name (e.g., atlas_higgs_ml, planck)")
    parser.add_argument('--process', type=str, default='drell_yan',
                        help="Hard process for cross‑section calculation")
    parser.add_argument('--sqrt_s', type=float, default=13000.0,
                        help="Collider center‑of‑mass energy (GeV)")
    parser.add_argument('--device', default='cpu', choices=['cpu','cuda','mps','ascend'])
    parser.add_argument('--seed', type=int, default=42)
    return parser.parse_args()

def main():
    args = parse_args()
    torch.manual_seed(args.seed)
    framework = StandardOne(device=args.device)

    if args.task == 'load_collider':
        if args.dataset == 'atlas_higgs_ml':
            features, labels = framework.load_collider_data('atlas_higgs_ml')
            print(f"Loaded ATLAS Higgs ML: {features.shape[0]} events, {features.shape[1]} features")
            print("First event:", features[0], "Label:", labels[0])
        else:
            print("Other collider datasets require ROOT file path in config.")
    elif args.task == 'load_cosmo':
        if args.dataset == 'planck':
            ell, D = framework.load_cosmology_data('planck')
            print(f"Planck CMB TT: {len(ell)} multipoles, first: ell={ell[0]}, D={D[0]}")
    elif args.task == 'cross_section':
        xs = framework.compute_hadronic_cross_section(args.process, args.sqrt_s)
        print(f"Cross‑section for {args.process} at {args.sqrt_s} GeV: {xs.item():.3e} pb")
    elif args.task == 'fit_cosmo':
        cosmo = framework.setup_cosmology()
        data = framework.load_cosmology_data('planck')
        optimizer = torch.optim.Adam(cosmo.parameters(), lr=0.01)
        for epoch in range(100):
            optimizer.zero_grad()
            nll = cosmo.likelihood_planck(data)
            nll.backward()
            optimizer.step()
            if epoch % 10 == 0:
                print(f"Epoch {epoch}: NLL={nll.item():.3f}, H0={cosmo.H0.item():.1f}, Ωm={cosmo.Omega_m.item():.3f}")
    elif args.task == 'unification':
        couplings = framework.run_unification_test(2e16)
        print(f"Unification at 2e16 GeV: {couplings}")

if __name__ == "__main__":
    main()
