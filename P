# 0. Device / Backend Utilities
# =============================================================================
def get_device(preferred: str = "cuda") -> torch.device:
    """Select the appropriate compute device."""
    if preferred == "cuda" and torch.cuda.is_available():
        return torch.device("cuda")
    if preferred == "mps" and torch.backends.mps.is_available():
        return torch.device("mps")
    if preferred == "ascend":
        if hasattr(torch, "npu") and torch.npu.is_available():
            return torch.device("npu")
    if torch.cuda.is_available():
        return torch.device("cuda")
    if torch.backends.mps.is_available():
        return torch.device("mps")
    return torch.device("cpu")


# =============================================================================
# 1. Data Generation & Loading
# =============================================================================
class CMSDiphotonData:
    """Handle CMS H→γγ data: simulation or loading from ROOT files."""
    def __init__(self, mass_range=(100, 180), n_bkg=12000, n_sig=600,
                 signal_mean=125.0, signal_sigma=1.4, device='cpu'):
        self.mass_range = mass_range
        self.device = device
        self.n_bkg = n_bkg
        self.n_sig = n_sig
        self.signal_mean = signal_mean
        self.signal_sigma = signal_sigma
        self.data = None

    def generate_simulated(self, seed=42):
        """Generate toy Monte Carlo data similar to CMS Run 2."""
        np.random.seed(seed)
        background = self.mass_range[0] + stats.expon.rvs(scale=30, size=self.n_bkg)
        signal = np.random.normal(self.signal_mean, self.signal_sigma, self.n_sig)
        mgg = np.concatenate([background, signal])
        mgg = mgg[(mgg >= self.mass_range[0]) & (mgg <= self.mass_range[1])]
        self.data = torch.tensor(mgg, dtype=torch.float32, device=self.device)
        return self.data

    def load_from_root(self, filepath, treename, mass_branch):
        """Load diphoton mass from a ROOT file (CERN Open Data format)."""
        if not HAS_UPROOT:
            raise ImportError("uproot is required to read ROOT files. Install with 'pip install uproot'.")
        with uproot.open(filepath) as f:
            tree = f[treename]
            masses = tree[mass_branch].array(library='np')
        if HAS_AWKWARD:
            masses = ak.flatten(masses).to_numpy()
        mgg = masses[(masses >= self.mass_range[0]) & (masses <= self.mass_range[1])]
        self.data = torch.tensor(mgg, dtype=torch.float32, device=self.device)
        return self.data


# =============================================================================
# 2. Structural Deterministic Probability Models
# =============================================================================
class StructuralLikelihood(nn.Module):
    """
    Fully differentiable structural likelihood for CMS H→γγ.
    Implements:
      L = Π_i [ μ·S(m_i) + B(m_i) + λ·J(m_i | Γ) ]
    with signal S (Gaussian), background B (exponential), and interface jump J.
    All operations are PyTorch tensors for autograd.
    """
    def __init__(self, mass_range=(100, 180), device='cpu'):
        super().__init__()
        self.mass_range = mass_range
        self.device = device

        # Learnable parameters (will be set externally or trained)
        self.register_parameter('log_mu', nn.Parameter(torch.tensor(0.0, device=device)))
        self.register_parameter('mH', nn.Parameter(torch.tensor(125.0, device=device)))
        self.register_parameter('log_sigma', nn.Parameter(torch.tensor(math.log(1.4), device=device)))
        self.register_parameter('log_a', nn.Parameter(torch.tensor(math.log(0.05), device=device)))
        self.register_parameter('log_lam', nn.Parameter(torch.tensor(math.log(0.5), device=device)))

        # Normalisation cache
        self._cache_norm_b = None

    @property
    def mu(self):
        return torch.exp(self.log_mu)

    @property
    def sigma(self):
        return torch.exp(self.log_sigma)

    @property
    def a(self):
        return torch.exp(self.log_a)

    @property
    def lam(self):
        return torch.exp(self.log_lam)

    def signal_pdf(self, m):
        """Normalised Gaussian signal shape."""
        return (1.0 / (self.sigma * math.sqrt(2 * math.pi))) * \
               torch.exp(-0.5 * ((m - self.mH) / self.sigma) ** 2)

    def background_pdf(self, m):
        """Normalised exponential background."""
        # Normalisation factor ∫_xmin^xmax exp(-a*m) dm
        xmin, xmax = self.mass_range
        # avoid repeated computation for each call: cache if a hasn't changed (simple approach)
        # For real autograd, recompute is fine; we'll use a lazy cache mechanism.
        if self._cache_norm_b is None or True:  # always recompute for simplicity, negligible cost
            norm = (torch.exp(-self.a * xmin) - torch.exp(-self.a * xmax)) / self.a
            self._cache_norm_b = norm
        return torch.exp(-self.a * m) / self._cache_norm_b

    def interface_jump(self, m):
        """Gaussian jump term localised around the Higgs mass (120–130 GeV)."""
        # The jump is defined only in the interface region, but we can implement
        # a smooth mask using a Gaussian window.
        return self.lam * torch.exp(-0.5 * ((m - 125.0) / 2.0) ** 2)

    def forward(self, m):
        """
        Compute the (unnormalised) PDF value for each mass point.
        Returns the full pdf = μ·S + B + λ·J, used for NLL construction.
        """
        ns = self.mu * 200.0   # scale factor as in original Section 218 code
        nb = len(m)            # number of background events normalisation? The original code had ns and nb as counts.
                                # We'll keep the same logic for consistency.
        sig = self.signal_pdf(m)
        bkg = self.background_pdf(m)
        jmp = self.interface_jump(m)
        pdf = ns * sig + nb * bkg + jmp
        return pdf

    def nll(self, m):
        """Negative log‑likelihood for the given mass data."""
        pdf = self.forward(m)
        pdf = torch.clamp(pdf, min=1e-12)
        return -torch.sum(torch.log(pdf))


