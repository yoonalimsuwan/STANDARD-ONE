def parse_args():
    parser = argparse.ArgumentParser(
        description="STANDARD ONE – Differentiable CMS H→γγ Structural Analysis"
    )
    parser.add_argument('--data-source', default='simulate',
                        choices=['simulate', 'root'],
                        help='Data source: simulate toy MC or load from ROOT file')
    parser.add_argument('--root-file', type=str, help='Path to ROOT file (if data-source=root)')
    parser.add_argument('--tree-name', type=str, default='diphoton', help='Name of the TTree')
    parser.add_argument('--mass-branch', type=str, default='m_yy', help='Branch name for diphoton mass')
    parser.add_argument('--mass-min', type=float, default=100.0)
    parser.add_argument('--mass-max', type=float, default=180.0)
    parser.add_argument('--n-bkg', type=int, default=12000)
    parser.add_argument('--n-sig', type=int, default=600)
    parser.add_argument('--device', default='cpu', choices=['cpu', 'cuda', 'mps', 'ascend'])
    parser.add_argument('--full-scan', action='store_true', help='Perform full profile likelihood scan')
    parser.add_argument('--distributed', action='store_true', help='Use DDP for distributed scanning')
    parser.add_argument('--seed', type=int, default=42)
    return parser.parse_args()

def main():
    args = parse_args()

    if args.distributed:
        # Launched via torchrun
        main_distributed()
        return

    config = {
        'mass_min': args.mass_min,
        'mass_max': args.mass_max,
        'n_bkg': args.n_bkg,
        'n_sig': args.n_sig
    }

    analysis = StandardOneAnalysis(config, device=args.device)

    if args.data_source == 'simulate':
        analysis.load_data(source='simulate', seed=args.seed)
    elif args.data_source == 'root':
        if not args.root_file:
            raise ValueError("--root-file must be specified when using ROOT data")
        analysis.load_data(source='root', filepath=args.root_file,
                           treename=args.tree_name, mass_branch=args.mass_branch)

    mu_hat, Z = analysis.run(use_full_scan=args.full_scan)
    analysis.print_deterministic_statement()

    # Display model parameters
    model = analysis.model
    logger.info(f"Fitted parameters:")
    logger.info(f"  μ = {model.mu.item():.4f}")
    logger.info(f"  mH = {model.mH.item():.2f} GeV")
    logger.info(f"  σ = {model.sigma.item():.2f} GeV")
    logger.info(f"  a = {model.a.item():.4f}")
    logger.info(f"  λ (interface strength) = {model.lam.item():.4f}")


if __name__ == "__main__":
    main()
