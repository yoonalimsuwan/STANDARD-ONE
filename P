# 5. Main Analysis Pipeline
# =============================================================================
class StandardOneAnalysis:
    """
    High‑level wrapper for the full CMS H→γγ structural analysis.
    """
    def __init__(self, config: Dict[str, Any], device='cpu'):
        self.cfg = config
        self.device = get_device(device)
        self.model = StructuralLikelihood(
            mass_range=(config.get('mass_min', 100), config.get('mass_max', 180)),
            device=self.device
        )
        self.data_handler = CMSDiphotonData(
            mass_range=(config.get('mass_min', 100), config.get('mass_max', 180)),
            n_bkg=config.get('n_bkg', 12000),
            n_sig=config.get('n_sig', 600),
            device=self.device
        )
        self.scanner = None
        self.data = None

    def load_data(self, source='simulate', **kwargs):
        if source == 'simulate':
            self.data = self.data_handler.generate_simulated(seed=kwargs.get('seed', 42))
        elif source == 'root':
            self.data = self.data_handler.load_from_root(
                filepath=kwargs['filepath'],
                treename=kwargs['treename'],
                mass_branch=kwargs['mass_branch']
            )
        else:
            raise ValueError(f"Unknown data source: {source}")
        self.scanner = ProfileLikelihoodScanner(self.model, self.data, device=self.device)
        return self.data

    def run(self, use_full_scan=True):
        if self.scanner is None:
            raise RuntimeError("Data not loaded. Call load_data() first.")
        if use_full_scan:
            mu_hat, Z = self.scanner.scan()
        else:
            mu_hat, Z = self.scanner.significance()
        logger.info(f"Best‑fit signal strength μ̂ = {mu_hat:.4f}")
        logger.info(f"Significance Z = {Z:.2f} σ")
        # Structural probability
        logger.info("Deterministic probability statement:")
        logger.info("P(event | full interface knowledge) = 1.0 (deterministic)")
        return mu_hat, Z

    def print_deterministic_statement(self):
        print("\n=== Structural Deterministic Probability ===")
        print("P(event | Γ fully resolved) → {0, 1}")
        print("When the interface manifold is completely known, the outcome is deterministic.")
        print("CMS measurements are incomplete projections of an underlying structural geometry.")
        print("The Higgs peak at 125 GeV is a stable structural attractor, not just a statistical fluctuation.")
        print("============================================")


