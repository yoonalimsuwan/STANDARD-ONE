# 6. Distributed Data Parallel Extensions (for large‑scale grids)
# =============================================================================
def distributed_scan(rank, world_size, cfg, mu_values):
    """
    Perform profile likelihood scan over a grid of μ values in parallel using DDP.
    Each rank processes a subset of μ values.
    """
    dist.init_process_group("gloo", rank=rank, world_size=world_size)
    device = get_device()
    torch.cuda.set_device(device)

    # Create local model and data (shared across ranks)
    model = StructuralLikelihood(mass_range=(cfg['mass_min'], cfg['mass_max']), device=device)
    data_handler = CMSDiphotonData(
        mass_range=(cfg['mass_min'], cfg['mass_max']),
        n_bkg=cfg['n_bkg'], n_sig=cfg['n_sig'], device=device
    )
    data = data_handler.generate_simulated(seed=42 + rank)  # use different seeds to avoid identical data
    scanner = ProfileLikelihoodScanner(model, data, device=device)

    # Distribute mu_values
    local_mus = mu_values[rank::world_size]
    local_nlls = []
    for mu in local_mus:
        nll = scanner._fit_nuisance(mu)
        local_nlls.append((mu, nll))

    # Gather results at rank 0
    all_results = [None for _ in range(world_size)]
    dist.all_gather_object(all_results, local_nlls)
    if rank == 0:
        combined = []
        for res_list in all_results:
            combined.extend(res_list)
        combined.sort(key=lambda x: x[0])
        return combined
    return None

def main_distributed():
    # Minimal example of distributed scanning
    parser = argparse.ArgumentParser()
    parser.add_argument('--local_rank', type=int, default=None)
    args = parser.parse_args()
    # Launch with torchrun
    rank = int(os.environ['RANK'])
    world_size = int(os.environ['WORLD_SIZE'])
    cfg = {'mass_min': 100, 'mass_max': 180, 'n_bkg': 12000, 'n_sig': 600}
    mu_values = np.linspace(0, 2, 25)
    results = distributed_scan(rank, world_size, cfg, mu_values)
    if rank == 0 and results:
        # Compute significance from combined scan (simplified: just for illustration)
        mus, nlls = zip(*results)
        nll0 = nlls[mus.index(0.0)]
        min_nll = min(nlls)
        q0 = 2 * (nll0 - min_nll)
        Z = math.sqrt(max(0, q0))
        print(f"Distributed significance: Z = {Z:.2f} σ")
    dist.destroy_process_group()


