# 3. Profile Likelihood and Significance
# =============================================================================
class AsymptoticSignificance:
    """
    Compute the significance Z using the profile likelihood ratio q₀.
    q₀ = -2 ln ( L(0, θ̂̂) / L(μ̂, θ̂) ),  μ̂ ≥ 0.
    Z = sqrt(q₀)  (asymptotic formula).
    """
    @staticmethod
    def q0(mu_hat, nll_mu0, nll_muhat):
        if mu_hat < 0:
            # In H→γγ, signal strength must be ≥ 0; if best-fit μ̂ < 0,
            # set μ̂=0 for q₀ calculation (as per standard methods).
            mu_hat = 0.0
        return 2 * (nll_mu0 - nll_muhat)

    @staticmethod
    def significance(q0_val):
        if q0_val <= 0:
            return 0.0
        return math.sqrt(q0_val)


class ProfileLikelihoodScanner:
    """
    Perform a profile likelihood scan over μ (signal strength) using
    a differentiable model and a PyTorch‑based optimiser.
    """
    def __init__(self, model: StructuralLikelihood, data: torch.Tensor,
                 device='cpu', optimizer='LBFGS'):
        self.model = model
        self.data = data
        self.device = device
        self.optimizer_name = optimizer

        # Initial values for nuisance parameters (mH, σ, a, λ)
        self.init_nuisance = {
            'mH': 125.0,
            'log_sigma': math.log(1.5),
            'log_a': math.log(0.05),
            'log_lam': math.log(0.5)
        }

    def _fit_nuisance(self, mu_fixed):
        """Minimize NLL for fixed μ, returning best nuisance params and NLL."""
        # Temporarily fix mu, optimize other parameters.
        # We'll use torch's LBFGS optimizer.
        model = self.model
        # Set mu parameter (not track gradient for mu here)
        with torch.no_grad():
            model.log_mu.copy_(torch.tensor(math.log(mu_fixed), device=self.device))

        # Collect parameters to optimize (all except log_mu)
        params = [model.mH, model.log_sigma, model.log_a, model.log_lam]
        # Reset to initial values for stable optimisation
        with torch.no_grad():
            model.mH.copy_(torch.tensor(self.init_nuisance['mH'], device=self.device))
            model.log_sigma.copy_(torch.tensor(self.init_nuisance['log_sigma'], device=self.device))
            model.log_a.copy_(torch.tensor(self.init_nuisance['log_a'], device=self.device))
            model.log_lam.copy_(torch.tensor(self.init_nuisance['log_lam'], device=self.device))

        # Use LBFGS from PyTorch
        optimizer = torch.optim.LBFGS(params, lr=1.0, max_iter=50, line_search_fn='strong_wolfe')
        # Closure for LBFGS
        def closure():
            optimizer.zero_grad()
            loss = model.nll(self.data)
            loss.backward()
            return loss

        optimizer.step(closure)
        final_nll = model.nll(self.data).item()
        return final_nll

    def scan(self, mu_range=(0.0, 2.0), n_points=25):
        """Scan μ values and compute profile NLL."""
        mus = np.linspace(mu_range[0], mu_range[1], n_points)
        nll_vals = np.zeros(n_points)
        # First find overall best-fit mu (unconstrained)
        # We'll use a simple grid search + refine.
        best_nll = float('inf')
        best_mu = 0.0
        # Coarse grid
        for i, mu in enumerate(mus):
            nll_vals[i] = self._fit_nuisance(mu)
            if nll_vals[i] < best_nll:
                best_nll = nll_vals[i]
                best_mu = mu
        # Refine around best_mu using a small window
        fine_mus = np.linspace(max(0, best_mu - 0.2), best_mu + 0.2, 11)
        for mu in fine_mus:
            nll = self._fit_nuisance(mu)
            # Not storing
        # Final best-fit and nll at mu=0
        nll_mu0 = self._fit_nuisance(0.0)
        # For best nll, we need the absolute minimum from the scan + refine
        # We'll re-evaluate the overall best-fit mu (unconstrained) with a broader optimisation
        # Use full model with all params free (including mu)
        with torch.no_grad():
            self.model.log_mu.copy_(torch.tensor(math.log(best_mu), device=self.device))
        # Optimize all params together
        all_params = [self.model.log_mu, self.model.mH, self.model.log_sigma,
                      self.model.log_a, self.model.log_lam]
        optimizer = torch.optim.LBFGS(all_params, lr=1.0, max_iter=100, line_search_fn='strong_wolfe')
        def closure():
            optimizer.zero_grad()
            loss = self.model.nll(self.data)
            loss.backward()
            return loss
        optimizer.step(closure)
        nll_muhat = self.model.nll(self.data).item()
        mu_hat = self.model.mu.item()

        # Build q₀ and Z
        q0 = AsymptoticSignificance.q0(mu_hat, nll_mu0, nll_muhat)
        Z = AsymptoticSignificance.significance(q0)
        return mu_hat, Z

    def significance(self):
        """Quick significance without full scan (using fixed mu=0 and best-fit)."""
        nll_mu0 = self._fit_nuisance(0.0)
        # Best-fit with mu free
        all_params = [self.model.log_mu, self.model.mH, self.model.log_sigma,
                      self.model.log_a, self.model.log_lam]
        optimizer = torch.optim.LBFGS(all_params, lr=1.0, max_iter=100, line_search_fn='strong_wolfe')
        def closure():
            optimizer.zero_grad()
            loss = self.model.nll(self.data)
            loss.backward()
            return loss
        optimizer.step(closure)
        nll_muhat = self.model.nll(self.data).item()
        mu_hat = self.model.mu.item()
        q0 = AsymptoticSignificance.q0(mu_hat, nll_mu0, nll_muhat)
        Z = AsymptoticSignificance.significance(q0)
        return mu_hat, Z


