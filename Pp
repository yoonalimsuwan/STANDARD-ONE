# 12. Full Analysis Pipeline
# =============================================================================
class StandardOneAnalysis:
    """
    Top‑level framework for structural particle physics inference.
    """
    def __init__(self, config: Dict[str, Any], device='cpu'):
        self.cfg = config
        self.device = get_device(device)
        self.csoc = CSOCKernel(device=self.device)
        self.ssc = SemanticStateContraction()
        self.rg = DiffRGRefiner(keep_fraction=config.get('rg_keep_frac', 0.5))
        self.generator = StructuralEventGenerator(
            final_state_pids=config.get('final_state', [22]),
            csoc_kernel=self.csoc,
            ssc=self.ssc,
            rg=self.rg,
            device=self.device,
            mass_range=(config.get('mass_min', 50), config.get('mass_max', 200)),
            n_events=config.get('n_events', 1000)
        )
        self.likelihood = StructuralLikelihood(self.generator)
        self.scanner = None
        self.data = None

    def load_data(self, source='simulate', **kwargs):
        if source == 'simulate':
            loader = CERNDataLoader(self.cfg['final_state'], device=self.device)
            self.data = loader.simulate(self.generator, n_samples=kwargs.get('n_samples', 1000))
        elif source == 'root':
            loader = CERNDataLoader(self.cfg['final_state'], device=self.device)
            self.data = loader.load_root(**kwargs)
        else:
            raise ValueError(f"Unknown data source: {source}")
        self.scanner = SignificanceScanner(self.likelihood, self.data, device=self.device)

    def train_soc(self):
        logger.info("Training CSOC kernel to data...")
        best = train_soc(self.likelihood, self.data, device=self.device)
        logger.info(f"Trained CSOC: {best}")
        # Set the trained parameters into the kernel
        with torch.no_grad():
            self.csoc.log_Cs.copy_(torch.tensor(math.log(best['Cs']), device=self.device))
            self.csoc.log_lambda.copy_(torch.tensor(math.log(best['lambda']), device=self.device))
            self.csoc.log_alpha.copy_(torch.tensor(math.log(best['alpha']), device=self.device))
            self.csoc.log_theta.copy_(torch.tensor(math.log(best['theta']), device=self.device))
            self.csoc.log_tau.copy_(torch.tensor(math.log(best['tau']), device=self.device))

    def run(self, use_scan=True):
        if self.scanner is None:
            raise RuntimeError("Data not loaded.")
        if use_scan:
            mu_hat, Z = self.scanner.scan_mu()
        else:
            # Quick single‑point fit
            mu_hat, Z = self.scanner.scan_mu(steps=1)  # will not give proper Z without full scan
        logger.info(f"Best‑fit μ = {mu_hat:.3f}, significance Z = {Z:.2f} σ")
        # BV consistency
        bv = BVConsistency()
        # Compute observed conserved quantities (example: total energy)
        # (this is a placeholder – real analysis would compute from data)
        logger.info("BV consistency score: not computed (placeholder)")
        # Structural probability statement
        self._print_deterministic_statement()
        return mu_hat, Z

    def _print_deterministic_statement(self):
        print("\n===== Structural Deterministic Probability =====")
        print("P(event | Γ fully resolved) → {0, 1}")
        print("When all internal interface details are known, the outcome is deterministic.")
        print("Collider data are incomplete projections of the underlying geometry.")
        print("CSOC learns the coarse‑graining kernel that generates the observed probabilities.")
        print("================================================\n")

    def predict_vacuum_energy(self, L):
        """Estimate vacuum energy density using CSOC‑renormalised model."""
        est = VacuumEnergyEstimator(self.csoc)
        return est(torch.tensor(L, device=self.device)).item()


