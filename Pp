# =============================================================================
# 2. CSOC – Learnable Self‑Organised Criticality Kernel
# =============================================================================
class CSOCKernel(nn.Module):
    """
    5‑parameter learnable kernel for structural coarse‑graining.
    Controls the stochastic strength (effective temperature) of unresolved interfaces.
    """
    def __init__(self, init_Cs=0.18, init_lambda=12.0, init_alpha=0.5,
                 init_theta=1.0, init_tau=10.0, device='cpu'):
        super().__init__()
        self.log_Cs = nn.Parameter(torch.tensor(math.log(init_Cs), device=device))
        self.log_lambda = nn.Parameter(torch.tensor(math.log(init_lambda), device=device))
        self.log_alpha = nn.Parameter(torch.tensor(math.log(init_alpha), device=device))
        self.log_theta = nn.Parameter(torch.tensor(math.log(init_theta), device=device))
        self.log_tau = nn.Parameter(torch.tensor(math.log(init_tau), device=device))

    @property
    def Cs(self): return torch.exp(self.log_Cs)
    @property
    def lambd(self): return torch.exp(self.log_lambda)
    @property
    def alpha(self): return torch.exp(self.log_alpha)
    @property
    def theta(self): return torch.exp(self.log_theta)
    @property
    def tau(self): return torch.exp(self.log_tau)

    def forward(self, r):
        """r: dimensionless distance from criticality (local strain analogue)"""
        return self.Cs * torch.pow(r + 1e-6, -self.alpha) * torch.exp(-r / self.lambd)


# =============================================================================
# 3. SSC – Semantic‑State Contraction (Distributional Denoising)
# =============================================================================
class SemanticStateContraction:
    """
    Low‑pass filter for event distributions, removing spurious noise
    while preserving semantically meaningful features.
    """
    def __init__(self, epsilon_fp=0.0028, sigma_target=1.0):
        self.eps = epsilon_fp
        self.target = sigma_target
        self.prev = None

    def __call__(self, x):
        if self.prev is None or self.prev.device != x.device:
            self.prev = x.detach().to(x.device)
            return x
        new = self.prev + self.eps * (x - self.prev)
        self.prev = new.detach()
        return new


# =============================================================================
# 4. RG – Renormalisation Group Conservative Truncation
# =============================================================================
class DiffRGRefiner:
    """
    Conservative spectral filter that truncates high‑wavenumber components
    while preserving conserved quantities (mass, energy, momentum).
    """
    def __init__(self, keep_fraction=0.5):
        self.keep_fraction = keep_fraction

    def forward(self, x):
        # Apply to each feature independently via FFT
        x_hat = torch.fft.rfftn(x)
        dims = x.shape
        # Simple isotropic mask
        kx = torch.fft.fftfreq(dims[0], d=1.0, device=x.device)
        ky = torch.fft.fftfreq(dims[1], d=1.0, device=x.device)
        kz = torch.fft.rfftfreq(dims[2], d=1.0, device=x.device)
        KX, KY, KZ = torch.meshgrid(kx, ky, kz, indexing='ij')
        K_mag = torch.sqrt(KX**2 + KY**2 + KZ**2)
        mask = K_mag <= (self.keep_fraction * K_mag.max())
        mask[0, 0, 0] = True
        return torch.fft.irfftn(x_hat * mask.to(x_hat.dtype), s=x.shape)


# =============================================================================
# 5. BV – Batalin–Vilkovisky Consistency Diagnostic
# =============================================================================
class BVConsistency:
    """
    Measure the extent to which a stochastic event generator satisfies
    the classical master equation. In a discrete setting, this reduces to
    comparing the expected and observed variations of conserved quantities.
    """
    def __init__(self, reference_quantities=None):
        # reference_quantities: list of (mean, std) for conserved observables
        self.reference = reference_quantities

    def score(self, sample_means, sample_stds):
        """
        Returns a scalar score: small = consistent.
        Default: χ²‑like distance to reference.
        """
        if self.reference is None:
            return 0.0
        chi2 = 0.0
        for (ref_m, ref_s), (smp_m, smp_s) in zip(self.reference, zip(sample_means, sample_stds)):
            chi2 += ((smp_m - ref_m) / ref_s) ** 2
        return chi2


# =============================================================================
# 6. Structural Event Generator (Differentiable)
# =============================================================================
class StructuralEventGenerator(nn.Module):
    """
    Differentiable event generator based on the Structural Itô Dynamics.
    Produces a set of final‑state particles (pseudodata) with probabilities
    governed by the CSOC kernel.
    The interface Γ models the unresolved collision details; its strength is
    controlled by λ (analogous to the jump term in the original H→γγ model).
    """
    def __init__(self, final_state_pids, csoc_kernel: CSOCKernel, ssc: SemanticStateContraction,
                 rg: DiffRGRefiner, device='cpu', mass_range=(50, 200), n_events=1000):
        super().__init__()
        self.final_state_pids = final_state_pids
        self.csoc = csoc_kernel
        self.ssc = ssc
        self.rg = rg
        self.mass_range = mass_range
        self.n_events = n_events
        self.device = device

        # Learnable structural parameters
        self.register_parameter('log_mu', nn.Parameter(torch.tensor(0.0, device=device)))
        self.register_parameter('log_lam', nn.Parameter(torch.tensor(math.log(0.5), device=device)))
        self.register_parameter('log_T', nn.Parameter(torch.tensor(math.log(1.0), device=device)))  # effective temperature

    @property
    def mu(self): return torch.exp(self.log_mu)
    @property
    def lam(self): return torch.exp(self.log_lam)
    @property
    def T(self): return torch.exp(self.log_T)

    def generate(self, return_tensor=True):
        """
        Produce an event sample as a tensor of invariant masses (or other summary).
        The probability distribution is:
          P(m) ∝ signal(m; m0, σ) * [μ + background(m; a) + λ·J(m)]
        where the background and jump parameters are modulated by the CSOC kernel
        through the effective temperature T.
        """
        # Background shape: exponential with slope a = exp(-T) ~ 1/T
        a = torch.exp(-self.T)
        # Signal shape: Gaussian around a reference mass (e.g., Z, Higgs...)
        m0 = 125.0  # could be parameterised per final state
        sigma = 2.0

        # Generate masses uniformly in range, then weight
        m = torch.linspace(self.mass_range[0], self.mass_range[1], self.n_events, device=self.device)
        # Compute PDF
        sig = torch.exp(-0.5 * ((m - m0) / sigma) ** 2) / (sigma * math.sqrt(2 * math.pi))
        bkg = torch.exp(-a * m)
        bkg_norm = (torch.exp(-a * self.mass_range[0]) - torch.exp(-a * self.mass_range[1])) / a
        bkg = bkg / bkg_norm
        # Interface jump
        jump = self.lam * torch.exp(-0.5 * ((m - 125.0) / 2.0) ** 2)

        # Structural unnormalised probability
        ns = self.mu * 200.0
        nb = self.n_events
        pdf = ns * sig + nb * bkg + jump
        pdf = torch.clamp(pdf, min=1e-12)
        # Use this as weights to sample (via Categorical or continuous reweighting)
        # For differentiability we use the expected distribution (no sampling in forward)
        # Instead, we return the mass grid and corresponding probabilities.
        # The true event generation step can be done with torch.multinomial on a fine grid.
        return m, pdf

    def forward(self):
        return self.generate()


