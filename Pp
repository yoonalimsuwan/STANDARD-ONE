# 7. Data Loading from CERN ROOT Files (or Simulation)
# =============================================================================
class CERNDataLoader:
    """Load observed particle masses from ROOT or generate toy data."""
    def __init__(self, final_state_pids, mass_range=(50, 200), device='cpu'):
        self.final_state_pids = final_state_pids
        self.mass_range = mass_range
        self.device = device

    def load_root(self, filepath, treename, branch_name, selection=None):
        if not HAS_UPROOT:
            raise ImportError("uproot required. Install with 'pip install uproot'.")
        with uproot.open(filepath) as f:
            tree = f[treename]
            data = tree[branch_name].array(library='np')
        if HAS_AWKWARD and isinstance(data, ak.Array):
            data = ak.flatten(data).to_numpy()
        # Apply selection and mass range cut
        m = data[(data >= self.mass_range[0]) & (data <= self.mass_range[1])]
        return torch.tensor(m, dtype=torch.float32, device=self.device)

    def simulate(self, generator: StructuralEventGenerator, n_samples=1000):
        m, pdf = generator.generate()
        # Sample from pdf (use Categorical)
        probs = pdf / pdf.sum()
        indices = torch.multinomial(probs, n_samples, replacement=True)
        sampled_mass = m[indices]
        return sampled_mass.detach()


# =============================================================================
# 8. Differentiable Likelihood and Inference
# =============================================================================
class StructuralLikelihood(nn.Module):
    """
    Negative log‑likelihood for the structural model, built on top of the generator.
    """
    def __init__(self, generator: StructuralEventGenerator):
        super().__init__()
        self.generator = generator

    def forward(self, data):
        # data: observed mass values (tensor)
        m, pdf = self.generator.generate()
        # Interpolate pdf to data points
        pdf_interp = torch.zeros_like(data)
        # Linear interpolation (simple) – or use histogram binning
        # For simplicity, assume m is fine enough to use torch.searchsorted
        idx = torch.searchsorted(m, data)
        idx = torch.clamp(idx, 1, len(m)-1)
        m_left = m[idx-1]
        m_right = m[idx]
        t = (data - m_left) / (m_right - m_left + 1e-8)
        pdf_interp = (1 - t) * pdf[idx-1] + t * pdf[idx]
        pdf_interp = torch.clamp(pdf_interp, min=1e-12)
        nll = -torch.sum(torch.log(pdf_interp))
        return nll


# =============================================================================
# 9. Profile Likelihood and Significance Scanner
# =============================================================================
class SignificanceScanner:
    def __init__(self, model: StructuralLikelihood, data: torch.Tensor, device='cpu'):
        self.model = model
        self.data = data
        self.device = device

    def fit_nuisance(self, mu_fixed):
        """Fit all parameters except mu (signal strength) and return NLL."""
        gen = self.model.generator
        with torch.no_grad():
            gen.log_mu.copy_(torch.tensor(math.log(mu_fixed), device=self.device))
        params = [gen.log_lam, gen.log_T]
        # plus CSOC kernel params
        params.extend([gen.csoc.log_Cs, gen.csoc.log_lambda, gen.csoc.log_alpha,
                       gen.csoc.log_theta, gen.csoc.log_tau])
        optimizer = torch.optim.LBFGS(params, lr=1.0, max_iter=30, line_search_fn='strong_wolfe')
        def closure():
            optimizer.zero_grad()
            loss = self.model(self.data)
            loss.backward()
            return loss
        optimizer.step(closure)
        return self.model(self.data).item()

    def scan_mu(self, mu_min=0.0, mu_max=2.0, steps=20):
        mus = np.linspace(mu_min, mu_max, steps)
        nlls = np.zeros(steps)
        for i, mu in enumerate(mus):
            nlls[i] = self.fit_nuisance(mu)
        # Determine mu_hat and significance
        nll0 = self.fit_nuisance(0.0)
        best_idx = np.argmin(nlls)
        mu_hat = mus[best_idx]
        if mu_hat < 0:
            mu_hat = 0.0
        q0 = 2 * (nll0 - min(nlls[best_idx], nll0))
        Z = math.sqrt(max(0, q0))
        return mu_hat, Z


# =============================================================================
# 10. SOC Trainer (Differential Evolution)
# =============================================================================
def train_soc(trainer_model, target_data, device='cpu'):
    """
    Train CSOC kernel parameters to match the observed data distribution.
    Uses SciPy's differential evolution (global optimisation).
    """
    gen = trainer_model.generator

    def objective(params):
        # Set CSOC parameters
        with torch.no_grad():
            gen.csoc.log_Cs.copy_(torch.tensor(math.log(params[0]), device=device))
            gen.csoc.log_lambda.copy_(torch.tensor(math.log(params[1]), device=device))
            gen.csoc.log_alpha.copy_(torch.tensor(math.log(params[2]), device=device))
            gen.csoc.log_theta.copy_(torch.tensor(math.log(params[3]), device=device))
            gen.csoc.log_tau.copy_(torch.tensor(math.log(params[4]), device=device))
        # Evaluate NLL
        nll = trainer_model(target_data).item()
        return nll

    bounds = [(0.05, 0.3), (5, 30), (0.1, 2.0), (0.5, 5.0), (1, 50)]
    result = differential_evolution(objective, bounds, maxiter=50, popsize=10, tol=1e-6, disp=False)
    best_params = {
        'Cs': result.x[0], 'lambda': result.x[1], 'alpha': result.x[2],
        'theta': result.x[3], 'tau': result.x[4]
    }
    return best_params


