class BlackHoleEventGenerator(StructuralEventGenerator):
    """
    Models Hawking radiation as an event generator where the CSOC kernel
    controls the information‑loss interface (event horizon).
    """
    def __init__(self, csoc_kernel, mass=1e12, device='cpu'):
        super().__init__(final_state_pids=[22], csoc_kernel=csoc_kernel,
                         ssc=SemanticStateContraction(), rg=DiffRGRefiner(),
                         device=device, mass_range=(0.1, 100), n_events=500)
        self.bh_mass = mass

    def generate(self):
        # Hawking temperature ~ 1/(8πM)
        T_hawking = 1.0 / (8 * math.pi * self.bh_mass)
        # Effective temperature modulated by CSOC
        m, pdf = super().generate()
        # Replace pdf with a Planckian (greybody factor approximated)
        beta = 1.0 / (T_hawking * self.csoc.Cs)  # CSOC adjusts effective temperature
        planck = (m**3) / (torch.exp(beta * m) - 1)
        planck = planck / planck.sum()
        # Mix with structural interface term
        pdf = planck + self.lam * torch.exp(-0.5 * ((m - 1.0) / 0.5) ** 2)
        return m, pdf

class VacuumEnergyEstimator(nn.Module):
    """
    Differentiable model for vacuum energy density prediction.
    Uses SOC to model unresolved Planck‑scale fluctuations.
    """
    def __init__(self, csoc: CSOCKernel):
        super().__init__()
        self.csoc = csoc
        self.scale = nn.Parameter(torch.tensor(1e-9))  # eV^4 scale

    def forward(self, length_scale):
        # Vacuum energy ~ ∫ k^3 dk up to cutoff → renormalised by SOC
        r = self.csoc(length_scale)
        return self.scale * r


