    torch.manual_seed(args.seed)

    if args.distributed:
        # Simplified launch (not full DDP implementation for brevity)
        raise NotImplementedError("Distributed mode requires torchrun. Use single‑GPU/CPU for now.")

    # Parse final state
    final_state_pids = [int(x) for x in args.final_state.split(',')]

    config = {
        'final_state': final_state_pids,
        'mass_min': args.mass_min,
        'mass_max': args.mass_max,
        'n_events': args.n_events,
        'rg_keep_frac': 0.5
    }

    analysis = StandardOneAnalysis(config, device=args.device)

    # Load data
    if args.data_source == 'simulate':
        analysis.load_data(source='simulate', n_samples=args.n_events)
    elif args.data_source == 'root':
        if not args.root_file:
            raise ValueError("--root-file required for ROOT data")
        analysis.load_data(source='root', filepath=args.root_file, treename=args.tree_name,
                           branch_name=args.mass_branch)

    # Optional SOC training
    if args.train_soc:
        analysis.train_soc()

    # Main analysis
    analysis.run(use_scan=args.scan)

    # Vacuum energy prediction (if requested)
    if args.predict_vacuum is not None:
        ve = analysis.predict_vacuum_energy(args.predict_vacuum)
        logger.info(f"Estimated vacuum energy density: {ve:.3e} eV^4")

if __name__ == "__main__":
    main()
